# Environments and tool caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.hypothesis/
.ruff_cache/
.cache/*
# archived API responses and logs are tracked by DVC (.cache/<name>.dvc); see README
!.cache/jev.dvc
!.cache/strong.dvc
!.cache/logs.dvc
!.cache/.gitignore

# Pipeline outputs are tracked by DVC, not git (Spec 1, Determinism)
/scores/
# /runs/ (result snapshots) is tracked by DVC through runs.dvc
/grads/
/annotation/
# Spec 1 stage outputs under data/ (data/raw itself is tracked through data/raw.dvc)
/data/*
!/data/raw.dvc
!/data/.gitignore
/results/*
# ...except the two files the specs say are committed
!/results/gates.json
!/results/hypotheses.csv
/runs
